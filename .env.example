# Kinetix L2 Optional Runtime Environment Overrides
# Kinetix L2 operates 100% offline-first and requires ZERO API keys or external secrets.

# Override persistent SQLite3 WAL storage directory (optional; defaults to OS AppData / XDG_DATA_HOME)
KINETIX_DATA_DIR=

# Override display scaling factor on desktop X11/Wayland/Win32/Cocoa (range: 0.75 to 4.0)
KINETIX_DPI_SCALE=1.0

# Enable reduced-motion accessibility behavior (set to 1 or true to disable nonessential transitions)
KINETIX_REDUCED_MOTION=0

# Enable stdout emission of accessibility screen-reader announcements for automated testing (0 or 1)
KINETIX_A11Y_STDOUT=0
